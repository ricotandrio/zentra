{
  "name": "zentra",
  "version": "1.0.0",
  "description": "Zentra is a personal automation hub",
  "main": "src/bootstrap/main.ts",
  "directories": {
    "doc": "docs"
  },
  "keywords": [
    "bot"
  ],
  "type": "commonjs",
  "author": "@ricotandrio",
  "scripts": {
    "prepare": "husky install",
    "clean": "rimraf dist",
    "build": "npm run clean && tsc && tsc-alias",
    "dev": "dotenv -e .env -- tsx watch src/bootstrap/main.ts",
    "start": "dotenv -e .env -- node dist/bootstrap/main.js",
    "test": "jest --coverage --watchAll=false",
    "test:unit": "jest --testPathPattern=unit --coverage --watchAll=false",
    "test:integration": "jest --testPathPattern=integration --coverage --watchAll=false",
    "test:watch": "jest --watch",
    "lint": "eslint src tests",
    "prettier:check": "prettier --check src tests",
    "prettier:fix": "prettier --write src tests",
    "docker:build": "docker build --platform linux/amd64 -t ricotandrio/zentra:latest .",
    "docker:run": "docker run -d --name zentra -p 3000:3000 --env-file .env ricotandrio/zentra:latest"
  },
  "license": "ISC",
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.8",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.6.0",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "dotenv-cli": "^7.4.2",
    "eslint": "^10.2.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@google/genai": "^2.13.0",
    "better-sqlite3": "^9.6.0",
    "discord.js": "^14.26.3",
    "express": "^5.2.1",
    "node-cron": "^3.0.3",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "playwright": "^1.60.0",
    "typescript-eslint": "^8.59.1",
    "yahoo-finance2": "^3.14.0"
  }
}
