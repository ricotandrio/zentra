{
  "name": "zentra",
  "version": "1.0.0",
  "description": "Zentra is a personal automation hub",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "prepare": "husky install",
    "dev:api": "dotenv -e .env -- tsx watch src/bootstrap/main.api.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src tests --max-warnings 0",
    "format": "prettier --write src tests",
    "prettier:check": "prettier --check src tests",
    "prettier:fix": "prettier --write src tests"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.11",
    "@types/node": "^25.6.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "dotenv-cli": "^7.4.2",
    "eslint": "^10.2.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "discord.js": "^14.26.3",
    "express": "^5.2.1",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "typescript-eslint": "^8.59.1"
  }
}
