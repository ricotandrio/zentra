{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "git *": "deny",
      "npm install *": "ask",
      "npm run *": "allow",
      "npm test *": "allow",
      "npm lint *": "allow",
      "npm *": "ask",
      "npx tsc *": "allow",
      "npx jest *": "allow",
      "npx eslint *": "allow",
      "npx *": "ask",
      "node *": "ask",
      "ls *": "allow",
      "cat *": "allow",
      "mkdir *": "allow",
      "cp *": "ask",
      "mv *": "ask",
      "find * -delete*": "deny",
      "truncate *": "ask",
      "dd *": "deny",
      "mkfs *": "deny",
      "diskutil *": "deny",
      "mount *": "ask",
      "umount *": "ask",
      "rm -rf *": "deny",
      "rm *": "ask",
      "chmod *": "ask",
      "chown *": "deny",
      "sudo *": "deny",
      "su *": "deny",
      "doas *": "deny",
      "pkexec *": "deny",
