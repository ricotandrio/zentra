      ".claude/**": "deny",
      "/etc/*": "deny",
      "/usr/*": "deny",
      "/var/*": "deny",
      "/root/*": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "webfetch": "ask",
    "websearch": "ask",
    "external_directory": {
