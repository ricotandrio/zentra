# ============================================================
# Zentra — Environment Configuration
# Copy this file to `.env` and fill in the values
# ============================================================


# ────────────────────────────────────────
# DISCORD
# ────────────────────────────────────────

# Bot token from Discord Developer Portal → Your App → Bot → Token
DISCORD_BOT_TOKEN=

# Your Discord Application ID (OAuth2 → General → Application ID)
DISCORD_CLIENT_ID=

# The Guild (Server) ID where the bot is deployed
# Right-click your server icon → Copy Server ID (Developer Mode must be on)
DISCORD_GUILD_ID=

# Channel ID where daily standup posts will be sent
# Right-click the channel → Copy Channel ID
DISCORD_STANDUP_CHANNEL_ID=


# ────────────────────────────────────────
# LLM
# ────────────────────────────────────────

# API key for LLM provider (OpenAI / Gemini)
LLM_API_KEY=

# Provider: openai | gemini
LLM_PROVIDER_NAME=gemini

# Model name (depends on provider)
# Example:
# - openai → gpt-4.1
# - gemini → gemini-2.0-flash
LLM_MODEL_NAME=gemini-2.0-flash


# ────────────────────────────────────────
# AZURE DEPLOYMENT
# ────────────────────────────────────────

# Azure resource group for ACI
AZURE_RESOURCE_GROUP=

# ACR login server (example: myregistry.azurecr.io)
ACR_LOGIN_SERVER=

# ACR admin username
ACR_USERNAME=

# ACR admin password
ACR_PASSWORD=

# Image naming
IMAGE_APP_NAME=zentra


# ────────────────────────────────────────
# OTHERS
# ────────────────────────────────────────

# Environment: development | production
NODE_ENV=development

# DISPLAY environment variable for headless browsers (Xvfb)
DISPLAY=:99

# API server port
EXPRESS_PORT=3000

# API URL
API_BASE_URL=http://localhost:3000

# URL for trading summary page
TRADING_SUMMARY_URL=


# ────────────────────────────────────────
# LOG ROTATION
# ────────────────────────────────────────

# Number of days to keep hot (uncompressed) log directories
LOG_HOT_ROTATE=3

# Number of days to keep cold (compressed .zip) log archives
LOG_COLD_ROTATE=7

LOG_LEVEL=info