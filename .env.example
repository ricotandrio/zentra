# ============================================================
# Zentra — Environment Configuration
# Copy this file to `.env` and fill in the values
# ============================================================


# ────────────────────────────────────────
# GENERAL
# ────────────────────────────────────────

# Environment: development | production
NODE_ENV=development


# ────────────────────────────────────────
# EXPRESS
# ────────────────────────────────────────

# API server port
EXPRESS_PORT=3000


# ────────────────────────────────────────
# DISCORD
# ────────────────────────────────────────

# Bot token from Discord Developer Portal
DISCORD_BOT_TOKEN=

# Discord Application (Client) ID
DISCORD_CLIENT_ID=

# Discord Server (Guild) ID
DISCORD_GUILD_ID=

# Channel ID for standup / market analysis output
DISCORD_STANDUP_CHANNEL_ID=


# ────────────────────────────────────────
# LLM
# ────────────────────────────────────────

# API key for LLM provider (OpenAI / Gemini)
LLM_API_KEY=

# Provider: openai | gemini
LLM_PROVIDER_NAME=gemini

# Model name (depends on provider)
# Example:
# - openai → gpt-4.1
# - gemini → gemini-2.0-flash
LLM_MODEL_NAME=gemini-2.0-flash


# ────────────────────────────────────────
# GITHUB
# ────────────────────────────────────────

# Personal Access Token (repo + project scopes)
GITHUB_PERSONAL_ACCESS_TOKEN=

# Repository owner (username or org)
GITHUB_OWNER_USERNAME=

# Repository name
GITHUB_REPOSITORY_NAME=


# ────────────────────────────────────────
# URLs
# ────────────────────────────────────────

# Base URL for webhook callbacks
WEBHOOK_BASE_URL=http://localhost:3000

# Base URL for API access
API_BASE_URL=http://localhost:3000
